# Docker Compose input. Copy to .env and replace example secrets.
# Full defaults, scope, and standalone settings: docs/configuration.md.
# Compose only forwards variables listed in docker-compose.yml.

# Required upstream SIP PBX hostname/IP, without a scheme.
PBX_HOST=pbx.example.com
# Upstream SIP destination port; set explicitly for TLS if needed.
PBX_PORT=5060
# Upstream signaling transport: udp, tcp, or tls. TLS template disables certificate verification.
PBX_TRANSPORT=udp
# Required upstream authentication username; kept in Asterisk in Docker mode.
PBX_USERNAME=101
# Required upstream secret. Replace this example; do not commit .env.
PBX_PASSWORD=change-me
# Registration user part; can differ from authentication username. Empty falls back to PBX_USERNAME.
PBX_AOR=101
# Upstream digit signaling mode used by Asterisk.
PBX_DTMF_MODE=rfc4733
# Server-managed PBX identity shown in the dashboard.
PBX_DISPLAY_NAME=Desk 101
# Browser call audio uses two UDP ports; browsers must reach both directly (not via the HTTP proxy).
# Microphone audio from the answering browser into the gateway.
WEBRTC_MIC_PORT=40000
# Caller audio from the gateway to the answering browser's speaker. Must differ from the mic port.
WEBRTC_SPEAKER_PORT=40001
# Optional hostname/IP in ICE candidates; empty uses WebSocket X-Forwarded-Host then Host.
# Set when proxy Host or media reachability differs from the dashboard URL (docs/configuration.md).
WEBRTC_ANNOUNCED_ADDRESS=

# Optional read-only LDAP contacts. Leave URL/base DN empty to hide contacts.
# Directory URL; empty disables contacts. Prefer ldaps:// or LDAP StartTLS.
LDAP_URL=
# Subtree search root; both URL and base DN are required.
LDAP_BASE_DN=
# Read-only bind identity; omit both bind fields for anonymous reads.
LDAP_BIND_DN=
# Bind secret (not trimmed); a partial bind pair disables contacts.
LDAP_BIND_PASSWORD=
# LDAP search filter applied to all directory requests.
LDAP_FILTER=(objectClass=person)
# Display name attribute; first nonempty string is used.
LDAP_NAME_ATTRIBUTE=cn
# Dial target attribute; multiple values create multiple contacts.
LDAP_PHONE_ATTRIBUTE=telephoneNumber
# Only literal true enables StartTLS; use with ldap://, not ldaps://.
LDAP_START_TLS=false

# Advanced Node-only settings (not forwarded by shipped Compose):
# ARI/AMI endpoints and credentials are generated internally by the entrypoint.
# NODE_EXTRA_CA_CERTS requires a Compose override.
